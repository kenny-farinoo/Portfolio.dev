---
interface Props {
  title: string;
  description: string;
  link?: string;
  date: string;
}

const { title, description, date } = Astro.props;
---
 
<li class="mb-10 ms-4">
  <div class="absolute w-3 h-3 bg-white rounded-full mt-1.5 -start-1.5 border border-buffer"></div>
  <time class="text-sm font-normal leading-none text-body text-blue-200">{date}</time>
  <h3 class="text-pretty font-normal text-heading my-2 text-yellow-200">{title}</h3>
  <p class="text-base font-normal text-body">{description}</p>
</li>